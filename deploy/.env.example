# Copy to deploy/.env on the server and chmod 600 it.
# Server IP with dashes, e.g. 203-0-113-10.sslip.io
GIST_DOMAIN=
# openssl rand -base64 24
GIST_DB_PASSWORD=
# openssl rand -base64 32  (must differ from GIST_JWT_SECRET)
GIST_ENCRYPTION_KEY=
# openssl rand -base64 32
GIST_JWT_SECRET=
GROQ_API_KEY=
RESEND_API_KEY=
GIST_MAIL_FROM=Gist <onboarding@resend.dev>

# Or Gmail SMTP (delivers to anyone): GIST_MAIL_PROVIDER=smtp plus an app password.
GIST_MAIL_PROVIDER=resend
GIST_SMTP_USERNAME=
GIST_SMTP_PASSWORD=
